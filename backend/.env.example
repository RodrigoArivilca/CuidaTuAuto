# Copiar como .env. No subir el archivo .env al repositorio.
PORT=4000
HOST=0.0.0.0
# Sin DATABASE_URL se usa PGlite persistente, sin instalar PostgreSQL.
DATABASE_MODE=pglite
DATA_DIR=./data
DEMO_MODE=true
# Para PostgreSQL: DATABASE_MODE=postgres y una URL válida.
# DATABASE_URL=postgresql://cuidatuauto:CAMBIAR@localhost:5432/cuidatuauto
# DATABASE_SSL=false
# Producción: DEMO_MODE=false y JWT_SECRET aleatorio de al menos 32 caracteres.
# En desarrollo, si falta JWT_SECRET se genera en data/jwt-secret.
# JWT_SECRET=
# Orígenes web autorizados (separados por coma). Apps nativas no envían Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
